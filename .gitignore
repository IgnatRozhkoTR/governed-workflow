# Exclude everything by default
*

# Include workflow components
!.gitignore
!.github/
!.github/**
!README.md
!CLAUDE.md
!AGENTS.md
!LICENSE

!admin-panel/
!admin-panel/**
!claude/
!claude/**
!codex/
!codex/**
claude/skills/code-review/
claude/skills/evy-sync/
claude/skills/pack-sessions-skill/
claude/skills/postman-collection/
!.claude/
!.claude/**

# Installed payload copies (rendered by the installer from claude/)
.claude/agents/
.claude/skills/
.claude/hooks/
.claude/defaults/
.claude/git-hooks/
.claude/git-rules.md
.claude/rules
.claude/scheduled_tasks.lock

# Re-exclude unwanted files within included dirs
**/__pycache__/
**/*.pyc
**/.DS_Store
*.db
*.db-shm
*.db-wal
*.zip
admin-panel/backend/projects.json
admin-panel/.reviews/
admin-panel/backend/sdkman*/
claude/tools/*
!claude/tools/kotlin-lsp-launcher.py
claude/modules-local/
